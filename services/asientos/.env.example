# Copiá este archivo a .env y completá los valores. El .env NO se sube a git.
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asientos_db
# Secreto para firmar y verificar los JWT. Tiene que ser el mismo que usa el resto del grupo.
JWT_SECRET=
# Opcionales
SEGUNDOS_BLOQUEO=60
INTERVALO_VENCIMIENTO_MS=5000
# Tiempo real (arranque alternativo)
WS_PING_INTERVAL_MS=25000
WS_MAX_PAYLOAD_BYTES=1024
WS_TIEMPO_GRILLA_MS=10000
WS_MAX_CAMBIOS_PENDIENTES=256
WS_CIERRE_TIMEOUT_MS=2000
