+async function obtenerAsiento(id, conexion = pool, actualizado = false) {
+  const [[fila]] = await conexion.execute(`SELECT ${COLUMNAS} FROM asientos WHERE id = ?`, [id]);
+  if (!fila) return null;
+  return aAsiento(actualizado ? { ...fila, vencido: false } : fila);
+}
+
+// Conserva el bloqueo de la fila hasta leer el estado exacto de esta mutación.
+async function cambiarAsiento(operacion, id, usuarioId) {
+  const conexion = await pool.getConnection();
+  try {
+    await conexion.beginTransaction();
+    const cambiado = await operacion(id, usuarioId, conexion);
+    const asiento = await obtenerAsiento(id, conexion, cambiado);
+    await conexion.commit();
+    return { cambiado, asiento };
+  } catch (error) {
+    await conexion.rollback().catch(() => {});
+    throw error;
+  } finally {
+    conexion.release();
+  }
 }

